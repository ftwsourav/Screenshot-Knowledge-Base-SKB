{
  "name": "@skb/desktop",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm run build:watch\" \"wait-on http://localhost:3000 && node scripts/launch.js\"",
    "dev:electron": "node scripts/launch.js",
    "dev:web": "cd ../web && npm run dev",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:electron": "electron-builder",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "@skb/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0"
  }
}