# SKB configuration (copy to .env and adjust)
SKB_DB_PATH=./data/database.db
SKB_IMAGES_PATH=./data/images
SKB_PORT=5656
SKB_LOG_LEVEL=info
SKB_ENCRYPTION=false
SKB_ENCRYPTION_KEY=
# URLs
SKB_WEB_URL=http://localhost:3000
SKB_API_URL=http://localhost:5656
# Web client (must be NEXT_PUBLIC_ prefixed to be exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:5656